<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ESP32 Nav</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ESP32 Nav</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Quyen Thu vien anh & Camera de tai anh len ESP32 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O app precisa acessar suas fotos para você escolher um fundo de tela para o ESP32</string>
	<key>NSCameraUsageDescription</key>
	<string>O app precisa da câmera para você tirar uma foto para o fundo de tela do ESP32</string>

	<!-- Quyen Bluetooth ket noi ESP32 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>O app precisa do Bluetooth para enviar a navegação para a tela do ESP32</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>O app precisa do Bluetooth para conectar ao ESP32</string>

	<!-- Quyen doc thong tin bai hat dang phat tu iPhone -->
	<key>NSAppleMusicUsageDescription</key>
	<string>O app precisa ler a música que está tocando para mostrar na tela do ESP32</string>

	<!-- Quyen Vi tri GPS -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O app precisa da sua localização para traçar a rota e navegar</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O app precisa da localização contínua para continuar enviando as curvas ao ESP32 mesmo com a tela apagada</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>O app precisa da localização contínua para navegar em segundo plano</string>

	<!-- Quyen Ket noi Mang Cuc bo & HTTP Khong Ma hoa (Wi-Fi ESP32 192.168.4.1) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>O app precisa da rede local para enviar o mapa ao ESP32 pelo Wi-Fi</string>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
